# ------------------------------------------------------------------
# Local development configuration.
#
# Copy this file to .env if you need to change something:
#     cp .env.example .env
#
# Leaving a variable empty uses the value docker-compose.yml already
# provides, so copying this file unchanged is safe and the stack still
# starts with `docker compose up --build`.
# ------------------------------------------------------------------

# --- Database ---

# User the application connects to PostgreSQL with.
# Empty -> commercial_ops
POSTGRES_USER=

# Password for that user. Fine to leave empty on your own machine.
# Always set it on any server other people can reach.
POSTGRES_PASSWORD=

# Database the application stores its data in.
# Empty -> commercial_ops
POSTGRES_DB=

# Full connection string. Change it only to point the application at a
# different database than the one docker compose starts.
# Example: postgresql+psycopg://user:password@db:5432/dbname
DATABASE_URL=

# Connection string used by the test suite. It must point at a DIFFERENT
# database: the tests delete every row before running, and would wipe your
# data if they shared one with the application.
TEST_DATABASE_URL=

# Ceiling on how long any single SQL statement may run, in milliseconds,
# waiting for a row lock included. 0 means no ceiling (PostgreSQL's own
# convention for this setting).
# Empty -> 5000
DB_STATEMENT_TIMEOUT_MS=

# --- Application ---

# How much detail appears in the logs.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Empty -> INFO
LOG_LEVEL=

# Reference date the sample data is built around. Set a fixed date such as
# 2026-06-15 to get exactly the same sample data every time.
# Empty -> today
SEED_ANCHOR_DATE=

# Address the browser loads the frontend from. The backend refuses requests
# coming from anywhere else.
# Empty -> http://localhost:5173
FRONTEND_ORIGIN=

# --- Phase 2 (SPEC-2) — not yet implemented ---
#
# Every variable below has a development default and is safe to leave empty,
# same as everything above. ANTHROPIC_API_KEY does not: see its own block.

# Bare Anthropic model ID (no date suffix), e.g. claude-haiku-4-5.
# Empty -> claude-haiku-4-5
LLM_MODEL=

# Sampling temperature for tool selection. Lower is more deterministic.
# Empty -> 0 (consistency over creativity in an agent that executes actions)
LLM_TEMPERATURE=

# How long the app waits for the model provider before giving up, in seconds.
# Empty -> 30
LLM_TIMEOUT_SECONDS=

# Hard cap on the tool-calling loop within a single turn.
# Empty -> 5
LLM_MAX_ITERATIONS=

# Hard cap on the length of the model's response, in tokens.
# Empty -> 1024
LLM_MAX_TOKENS=

# Hard budget guardrail: the orchestrator stops spending and returns a
# fallback once a session's accumulated cost passes this, in USD.
# Empty -> 1.00
MAX_COST_PER_SESSION_USD=

# Runs the agent against a keyword-driven fake model instead of the real one —
# no API key needed and no cost, and the three flows (orders, balance, status
# change with confirmation) all work. A product decision, not a test hack.
# Empty -> false
DEMO_MODE=

# Longest user message the chat endpoint accepts, in characters. Longer
# messages are rejected before the model is ever called.
# Empty -> 2000
MAX_MESSAGE_CHARS=

# How long a write action stays pending, waiting for user confirmation,
# before it expires and must be proposed again.
# Empty -> 300
PENDING_ACTION_TTL_SECONDS=

# Complete conversation turns kept verbatim in the history sent to the model.
# Older turns keep the assistant's text but drop tool_results.
# Empty -> 6
HISTORY_MAX_TURNS=

# Caps how many /chat turns one caller (X-User-Id) may start in a window,
# so a hundred fresh session_ids cannot drain the account the way the
# per-session cost cap alone allows. Set false to turn the limit off for a
# demo; the two values below stay meaningful when you turn it back on.
# /confirm is never limited: it calls no model, so it costs no tokens.
# Empty -> true
CHAT_RATE_LIMIT_ENABLED=

# Requests one caller may make per window. Must be at least 1: 0 here is a
# typo that would lock everyone out, so it is rejected at startup.
# Empty -> 20
CHAT_RATE_LIMIT_MAX_REQUESTS=

# Width of that window, in seconds.
# Empty -> 60
CHAT_RATE_LIMIT_WINDOW_SECONDS=

# --- Secrets ---
#
# Values in this section NEVER have a default here or in code. A secret with
# a default is a secret checked into the repository. Every variable above
# this line is safe to leave empty; nothing below is.

# Anthropic API key. Required unless DEMO_MODE=true. The app must fail
# loudly, not silently, when this is missing and needed.
ANTHROPIC_API_KEY=
