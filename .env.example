# ------------------------------------------------------------------
# Local development configuration.
#
# Copy this file to .env if you need to change something:
#     cp .env.example .env
#
# Leaving a variable empty uses the value docker-compose.yml already
# provides, so copying this file unchanged is safe and the stack still
# starts with `docker compose up --build`.
# ------------------------------------------------------------------

# --- Database ---

# User the application connects to PostgreSQL with.
# Empty -> commercial_ops
POSTGRES_USER=

# Password for that user. Fine to leave empty on your own machine.
# Always set it on any server other people can reach.
POSTGRES_PASSWORD=

# Database the application stores its data in.
# Empty -> commercial_ops
POSTGRES_DB=

# Full connection string. Change it only to point the application at a
# different database than the one docker compose starts.
# Example: postgresql+psycopg://user:password@db:5432/dbname
DATABASE_URL=

# Connection string used by the test suite. It must point at a DIFFERENT
# database: the tests delete every row before running, and would wipe your
# data if they shared one with the application.
TEST_DATABASE_URL=

# --- Application ---

# How much detail appears in the logs.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Empty -> INFO
LOG_LEVEL=

# Reference date the sample data is built around. Set a fixed date such as
# 2026-06-15 to get exactly the same sample data every time.
# Empty -> today
SEED_ANCHOR_DATE=

# Address the browser loads the frontend from. The backend refuses requests
# coming from anywhere else.
# Empty -> http://localhost:5173
FRONTEND_ORIGIN=
